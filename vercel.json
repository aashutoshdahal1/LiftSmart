{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/server.js": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/_build/(.*)", "destination": "/dist/client/_build/$1" },
    { "source": "/(.*)", "destination": "/api/server" }
  ]
}
